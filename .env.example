# All optional. Leave blank for a fully functional local demonstration.
# Required on Cloudflare Workers; optional for local Node.js JSON storage.
DATABASE_URL=
# DataBee SiteAtlas: live similar-site discovery with traffic estimates. Free key at console.databee.dev
DATABEE_API_KEY=
# treg tool catalog proxy: ad libraries, reviews, scraping, enrichment. Team token from treg.to
TREG_TOKEN=
# AIsa MCP gateway: Similarweb, SE Ranking and other providers through one key. Sign up at aisa.one
AISA_API_KEY=
# Per-call spend cap in USD; quotes above this skip batch_use and fall back.
AISA_MAX_COST_USD=0.50
SIMILARWEB_API_KEY=
# Apify MCP gateway: runs agentx/similarweb-pro-scraper (~$0.03/site) for traffic,
# engagement, keywords, backlinks, referrals and similar-site discovery.
APIFY_TOKEN=
# Optional endpoint override; defaults to the shared Similarweb Pro tool server.
APIFY_MCP_URL=https://mcp.apify.com/?tools=actors,docs,agentx/similarweb-pro-scraper
# Optional owner-supplied 1Lookup adapter: POST {domain} -> {visits:number}
ONELOOKUP_API_KEY=
ONELOOKUP_API_URL=
# No verified public Jev AI triage API. Both values required for the documented adapter contract.
JEV_API_KEY=
JEV_API_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ATTIO_API_KEY=
HUBSPOT_ACCESS_TOKEN=
